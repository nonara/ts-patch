{
  "include": [ "src" ],
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "lib": [ "ES2018" ],
    "types": [],
    "skipLibCheck": true,
    "noEmit": false,
    "plugins": [
      { "transform": "./transformer.ts" }
    ]
  }
}
